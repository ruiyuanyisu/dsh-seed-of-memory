{
  "name": "dsh-seed-of-memory",
  "version": "1.4.1",
  "private": false,
  "description": "Local-first memory layer for DeepSeek Harness: identity root, layered memories, beliefs, emotions, persona and speaking habits in one SQLite file.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "asr",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "SPEC.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "sqlite",
    "agents",
    "persona",
    "emotion"
  ],
  "license": "MIT",
  "author": "Seed of Memory contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruiyuanyisu/dsh-seed-of-memory.git"
  },
  "homepage": "https://github.com/ruiyuanyisu/dsh-seed-of-memory#readme",
  "bugs": {
    "url": "https://github.com/ruiyuanyisu/dsh-seed-of-memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dependencies": {}
}
